{
  "name": "project-template",
  "version": "1.0.0",
  "description": "Capstone Project Template ",
  "repository": {
    "type": "git",
    "url": "https://autocode.git.epam.com/campus_javascript/capstone-project/project-template.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "compile": "sass src/scss:dist/css --no-source-map",
    "build": "npm run compile",
    "watch": "sass --watch src/scss:dist/css --no-source-map",
    "serve": "live-server --open=src/index.html --watch=src,dist",
    "dev": "npm run compile && concurrently \"npm:watch\" \"npm:serve\"",
    "lint": "eslint src/js && stylelint \"src/scss/**/*.scss\"",
    "lint:fix": "eslint src/js --fix && stylelint \"src/scss/**/*.scss\" --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "live-server": "^1.2.2",
    "sass": "^1.108.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0"
  }
}
